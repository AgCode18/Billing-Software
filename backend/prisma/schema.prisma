generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  FINAL
  CANCELLED
  PAID
  PARTIALLY_PAID
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentRecordStatus {
  COMPLETED
  REVERSED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

model Invoice {
  id            String    @id @default(cuid())
  businessId    String
  invoiceNumber String
  invoiceDate   DateTime  @default(now())
  dueDate       DateTime?

  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerGst     String?

  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal @default(0) @db.Decimal(12, 2)

  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)

  notes String?

  business Business      @relation(fields: [businessId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([invoiceDate])
  @@index([status])
  @@index([paymentStatus])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String?

  productName String
  sku         String?
  unit        String  @default("PCS")

  quantity       Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  invoice         Invoice  @relation(fields: [invoiceId], references: [id],onDelete Cascade)

  product         Product? @relation(fields: [productId],  references id[])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id         String @id @default(cuid())
  businessId String
  invoiceId  String

  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime      @default(now())

  referenceNo String?
  notes       String?

  status PaymentRecordStatus @default(COMPLETED)

  reversedAt     DateTime?
  reversalReason String?

  invoice       Invoice              @relation(fields: [invoiceId],references: [id],onDelete Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([status])
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  role               UserRole
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)

  businessId String?
  business   Business? @relation(fields:[businessId],references id[])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

model Business {
  id        String @id @default(cuid())
  name      String
  ownerName String
  email     String
  phone     String

  logo      String?
  gstNumber String?
  panNumber String?

  address String?
  city    String?
  state   String?
  pincode String?
  country String? @default("India")

  isActive Boolean @default(true)

  // Invoice sequence
  invoiceSequence Int @default(0)

  users        User[]
  subscription Subscription?

  invoices Invoice[]
  payments Payment[]

  categories Category[]
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MembershipPlan {
  id           String       @id @default(cuid())
  name         String
  description  String?
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle

  maxProducts Int?
  maxInvoices Int?

  gstInvoice      Boolean @default(false)
  pdfInvoice      Boolean @default(false)
  reports         Boolean @default(false)
  advancedReports Boolean @default(false)

  isActive Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id         String @id @default(cuid())
  businessId String @unique

  business Business @relation(fields: [businessId],references id[])

  planId String

  plan MembershipPlan @relation(fields: [planId],references id[])

  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  autoRenew Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

model Category {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean @default(true)

  business Business @relation(fields: [businessId],references id[])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id         String  @id @default(cuid())
  businessId String
  categoryId String?

  name        String
  sku         String?
  description String?

  unit String @default("PCS")

  purchasePrice Decimal @db.Decimal(12, 2)
  sellingPrice  Decimal @db.Decimal(12, 2)

  taxRate Decimal @default(0) @db.Decimal(5, 2)

  stock Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  business Business @relation(
  fields: [businessId],
  references id[]
  )

  category Category? @relation(
  fields: [categoryId],
  references id[]
  )

  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
}
